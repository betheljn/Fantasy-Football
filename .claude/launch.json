{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081",
        "--clear"
      ],
      "port": 8081
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/server",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "server-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=8788",
        "pnpm",
        "--dir",
        "apps/server",
        "dev"
      ],
      "port": 8788
    },
    {
      "name": "mobile-web-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_SERVER_URL=http://localhost:8788",
        "pnpm",
        "--dir",
        "apps/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8083"
      ],
      "port": 8083
    },
    {
      "name": "mobile-ios",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/mobile",
        "exec",
        "expo",
        "start",
        "--port",
        "8085"
      ],
      "port": 8085
    }
  ]
}
